module

public meta import Lean.Elab.Command
-- One `import all` line per module of this library and of the libraries it requires, so that the
-- proofs are visible to the axiom check (the module system hides them from a plain `import`):
-- generated by scripts/gen_audit.py.
-- IMPORTS --

/-!
# Axiom audit

Run with `lake env lean scripts/Audit.lean` after `lake build` and `lake build Phylogenetics` (CI
builds both). It checks that every declaration of the library `PhyloStatistics` and of the library
`Phylogenetics` that it requires, private and auxiliary ones included, depends only on Lean's standard
axioms `propext`, `Classical.choice` and `Quot.sound` (a `sorry` would show up as the axiom
`sorryAx`), and lists the axioms of the main theorems. Declarations in Mathlib's namespaces are covered
too: the check goes through modules, not namespaces.
-/

open Lean Elab Command

namespace PhyloStatisticsAudit

/-- The main theorems of the library, with a short label. -/
meta def mainResults : List (String × Name) := []

/-- Lean's standard axioms. -/
meta def standardAxioms : List Name := [``propext, ``Classical.choice, ``Quot.sound]

/-- The libraries that the audit checks, by the root of their modules. -/
meta def isLibraryModule (m : Name) : Bool :=
  [`PhyloStatistics, `Phylogenetics].any (·.isPrefixOf m)

elab "#audit_hub" : command => do
  let env ← getEnv
  let mut bad : Array Name := #[]
  let mut rows : Array String := #["| Result | Lean | Axioms |", "| --- | --- | --- |"]
  for (label, n) in mainResults do
    let axs ← liftCoreM <| collectAxioms n
    if axs.any (!standardAxioms.contains ·) then bad := bad.push n
    rows := rows.push s!"| {label} | `{n}` | {", ".intercalate (axs.toList.map toString)} |"
  let mut count := 0
  for m in env.header.moduleNames, d in env.header.moduleData do
    if isLibraryModule m then
      for c in d.constNames do
        count := count + 1
        let axs ← liftCoreM <| collectAxioms c
        if axs.any (!standardAxioms.contains ·) then bad := bad.push c
  logInfo ((if mainResults.isEmpty then "" else "\n".intercalate rows.toList ++ "\n\n") ++
    s!"Checked {count} declarations of PhyloStatistics and Phylogenetics: " ++
    (if bad.isEmpty then "all use only the standard axioms." else "see the error."))
  unless bad.isEmpty do
    throwError m!"non-standard axioms used by: {bad}"

end PhyloStatisticsAudit

#audit_hub
